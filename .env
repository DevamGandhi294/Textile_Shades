# Copy these lines into backend/.env (the same file api.py reads) and change the values.
# Never commit .env.

# ---- PostgreSQL (docker-compose.yml starts one with these values)
DATABASE_URL=postgresql+psycopg://magic:magic@127.0.0.1:5432/magic_outline

# ---- Image storage. Local: MinIO from docker-compose.yml. Later Contabo: change only these 4 + endpoint.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=magicadmin
S3_SECRET_KEY=magicadmin123
S3_BUCKET=magic-outline
# Contabo example:  S3_ENDPOINT_URL=https://eu2.contabostorage.com   (keys from the Contabo panel)
# No Docker at all? STORAGE_BACKEND=local keeps images in backend/storage_data/ (fine for trying it out).

# Images reach the browser through the Next.js proxy (/api/backend/*). Leave as is.
FILES_URL_PREFIX=/api/backend/files

# ---- Security. Make SECRET_KEY a long random text:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-text
# API_TOKEN is shared with the Next.js server (BACKEND_API_TOKEN). Same value api.py already uses.
# API_TOKEN=
# 1 on the live https website, so the login cookie is only sent over https
COOKIE_SECURE=0

# ---- Login
# Forgot-password codes: "console" prints them in the server log (no SMS yet).
SMS_PROVIDER=console
# 1 = the API also returns the code (only for local testing, never on a real server)
OTP_DEV_ECHO=0
# Local only: act as this mobile number when nobody is logged in (leave empty on a real server)
DEV_LOGIN_PHONE=

# ---- Payments: off = buttons only (501 "coming soon"); fake = apply at once (local testing)
PAYMENTS_MODE=off
# RAZORPAY_WEBHOOK_SECRET=

# ---- Chat summaries (optional; without a key the summary is built from the party card)
# OPENAI_API_KEY=            (already in backend/.env for the image redraw)
# OPENAI_SUMMARY_MODEL=gpt-4.1-nano
