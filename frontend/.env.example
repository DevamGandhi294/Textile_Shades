# Copy this file to .env.local (local) or add the same names in Vercel (live site).

# Backend address used by the BROWSER (upload, settings, downloads).
# Local:     http://127.0.0.1:8000   (python api.py in ../backend)
# Live site: https://api.your-domain.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- server-only: NEVER prefix these with NEXT_PUBLIC_ (they would become visible in the browser) ---

# Same value as API_TOKEN in backend/.env. Added by src/app/api/perfect/route.ts to the paid
# "Make border perfect" call, so the backend accepts it. Leave empty only for local development.
API_TOKEN=

# Backend address as seen from this website's server (optional; default NEXT_PUBLIC_API_URL).
# Use it when the server can reach the backend on a private address.
# BACKEND_URL=http://127.0.0.1:8000
