# Copy to .env.local. These are read by the Next.js server only, never sent to the browser.

# Where the FastAPI backend (backend/api.py) runs
BACKEND_URL=http://127.0.0.1:8000
# Same value as API_TOKEN in backend/.env (leave empty if the backend has none)
BACKEND_API_TOKEN=

# 1 = parties, designs, chats, billing and login use built-in demo data (the backend has no database yet)
NEXT_PUBLIC_USE_MOCKS=1
