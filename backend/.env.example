# Copy to .env (never commit .env) and fill in. All values are optional except OPENAI_API_KEY for the AI redraw.

# OpenAI key for "Make border perfect" (platform.openai.com -> API keys); without it the button is hidden
OPENAI_API_KEY=
# image model used for the redraw (default gpt-image-2)
# OPENAI_IMAGE_MODEL=gpt-image-2
# --- AI layers (the "AI layers" tab: one image call per layer, so it costs more than one Make border perfect) ---
# image model for a COMPLETE (finished) design, and for an incomplete (rough) one; the real model ids of your key
# MODEL_COMPLETE=gpt-image-2.5-flare
# MODEL_INCOMPLETE=gpt-image-1-mini
# small vision model that checks the design first (step 1, answers in JSON)
# OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
# most layers (= image calls) per design, and how many times the layers can be made per uploaded photo
# AI_LAYERS_MAX_LAYERS=6
# AI_LAYERS_MAX_RUNS_PER_SESSION=2

# low | medium | high (default medium; low for cheap previews; high costs about 4x medium)
# OPENAI_IMAGE_QUALITY=medium
# gpt-image-1 models only: low (default) or high (closer to the picture, costs more); ignored by gpt-image-2
# OPENAI_INPUT_FIDELITY=low

# cheap text model for the chat that checks a request is about editing the border image (default gpt-4.1-mini)
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# chat messages allowed per uploaded photo (default 20) and for the whole server in a rolling hour (default 300)
# CHAT_MAX_MESSAGES_PER_SESSION=20
# CHAT_MAX_PER_HOUR=300

# shared secret: if set, POST /api/sessions/{id}/perfect needs the header "Authorization: Bearer <API_TOKEN>"
# API_TOKEN=
# paid redraws allowed per uploaded photo (default 3)
# PERFECT_MAX_PER_SESSION=3
# paid redraws allowed for the whole server in a rolling hour (default 60)
# PERFECT_MAX_PER_HOUR=60

# comma-separated website addresses allowed to call the API from a browser (default: local Next.js dev server)
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
